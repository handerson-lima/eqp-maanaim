{
  "name": "maanaim-functions",
  "private": true,
  "type": "module",
  "engines": { "node": "22" },
  "main": "lib/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "test": "npm run typecheck && vitest run",
    "test:emulator": "vitest run test/importacao.emulator.test.ts test/catalogo.emulator.test.ts",
